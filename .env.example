# Loco 环境变量示例，复制为 .env 后填入实际值: cp .env.example .env
LOCO_ENV=development
APP_NAME=locos

# 应用 (APP_*)
APP_PORT=5150
APP_BINDING=localhost
APP_URL=http://localhost

# 数据库 (DB_*，Docker 内部用容器名如 @postgres:5432)
DB_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DB
# Passkey / WebAuthn (生产环境应为 https 域名)
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5150
# Google OAuth2 / One Tap
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 测试库（可选，留空则用 config/test.yaml 内置默认值）
DB_URL_TEST=postgres://postgres:YOUR_PASSWORD@localhost:5432/YOUR_TEST_DB

# 缓存 (CACHE_*，Docker 内部用容器名如 @valkey:6379)
CACHE_URL=redis://127.0.0.1:6379/1
CACHE_MAX_SIZE=10

# 对象存储 (AWS_*，兼容 Garage / MinIO)
AWS_BUCKET=default
AWS_DEFAULT_REGION=garage
AWS_ENDPOINT=http://localhost:3900
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# 认证 (JWT_*)（运行 cargo loco task jwt:secret 自动生成）
JWT_SECRET=YOUR_JWT_SECRET_64_HEX_CHARS
JWT_TTL=604800

# 邮件 (MAIL_*)
MAIL_HOST=localhost
MAIL_PORT=1025
