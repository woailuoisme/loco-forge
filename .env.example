# Loco Application Environment Variables Example
# Copy this file to `.env` for local development: `cp .env.example .env`

# Application Environment (development, test, production)
LOCO_ENV=development

# Database Connection (SQLite or PostgreSQL)
# SQLite default: sqlite://loco-starter_development.sqlite?mode=rwc
# PostgreSQL example: postgres://postgres:postgres@localhost:5432/loco_starter_dev
DATABASE_URL=sqlite://loco-starter_development.sqlite?mode=rwc

# Redis Cache Configuration (Multi-process shared cache)
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_CACHE_MAX_SIZE=10


# Authentication & JWT Security
JWT_SECRET=mHuQ6y9WZiykqoDgaAEm
JWT_EXPIRATION=604800

# Web Server & Binding
PORT=5150
BINDING=localhost
SERVER_HOST=http://localhost

# Mailer Configuration (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025

# S3 Object Storage (Garage / MinIO)
STORAGE_S3_BUCKET=loco-starter
STORAGE_S3_REGION=garage
STORAGE_S3_ENDPOINT=http://localhost:3900
STORAGE_S3_ACCESS_KEY=garage_key
STORAGE_S3_SECRET_KEY=garage_secret

