# Loco 环境变量示例，复制为 .env 后填入实际值: cp .env.example .env
LOCO_ENV=development
APP_NAME=locos

# Web 服务
PORT=5150
BINDING=localhost
SERVER_HOST=http://localhost

# PostgreSQL（Docker 内部用容器名如 @postgres:5432）
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DB

# Valkey / Redis 缓存（Docker 内部用容器名如 @valkey:6379）
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_CACHE_MAX_SIZE=10

# S3 对象存储（Garage / MinIO）
STORAGE_S3_BUCKET=default
STORAGE_S3_REGION=garage
STORAGE_S3_ENDPOINT=http://localhost:3900
STORAGE_S3_ACCESS_KEY=YOUR_ACCESS_KEY
STORAGE_S3_SECRET_KEY=YOUR_SECRET_KEY

# JWT 认证（运行 cargo loco task jwt:secret 自动生成）
JWT_SECRET=YOUR_JWT_SECRET_64_HEX_CHARS
JWT_EXPIRATION=604800

# SMTP 邮件
SMTP_HOST=localhost
SMTP_PORT=1025
