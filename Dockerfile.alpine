ARG RUST_VERSION=1.98.0
ARG ALPINE_VERSION=3.21

# ── 阶段 1：Chef 基础阶段（直接使用官方 cargo-chef Alpine 预装镜像）───────────────
FROM lukemathwalker/cargo-chef:latest-rust-${RUST_VERSION}-alpine${ALPINE_VERSION} AS chef
WORKDIR /app
SHELL ["/bin/sh", "-o", "pipefail", "-c"]

# 安装 Musl 编译环境与 C 源码构建工具（tikv-jemalloc-sys 编译必需 make/gcc）
RUN apk add --no-cache musl-dev build-base make

# ── 阶段 2：Planner 依赖分析阶段（生成 recipe.json）───────────────────────────
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ── 阶段 3：Builder 预编译 Musl 依赖与源码构建阶段 ────────────────────
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json

# 预编译 Musl 第三方依赖
RUN cargo chef cook --release --recipe-path recipe.json

# 复制源码并编译 Musl 纯静态二进制
COPY . .
RUN cargo build --release --bin locos

# ── 阶段 4：最小化 Alpine Runtime 运行镜像 ───────────────────────────────────
FROM alpine:${ALPINE_VERSION} AS runtime

ENV LOCO_ENV=production \
    PORT=5150 \
    BINDING=0.0.0.0 \
    TZ=Asia/Shanghai \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

RUN apk add --no-cache ca-certificates tzdata \
    && cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app --no-create-home app

WORKDIR /app

# 从 Builder 阶段复制静态二进制、配置文件与国际化资源
COPY --from=builder --chown=app:app /app/target/release/locos /app/locos
COPY --chown=app:app config/ /app/config/
COPY --chown=app:app locales/ /app/locales/

# 预建运行时可写目录并授权给非 root 用户
RUN mkdir -p storages/logs storages/uploads storages/tmp && chown -R app:app /app/storages

USER 10001:10001
EXPOSE 5150

ENTRYPOINT ["/app/locos"]
CMD ["start"]
