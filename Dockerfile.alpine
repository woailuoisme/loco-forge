# ==============================================================================
# 文件作用：Alpine (Musl) + cargo-chef 纯静态极致轻量容器镜像构建规范
# 生效时机：执行 `docker build -f Dockerfile.alpine .` 或生产 CI/CD 流水线时执行
# 核心职责：
#   1. 基于 lukemathwalker/cargo-chef 预热并缓存依赖层，实现秒级增量编译
#   2. 使用 musl 静态编译出完全零动态依赖的独立 Rust 二进制程序
#   3. 采用 Alpine Linux 最小运行底包，最终容器镜像体积仅 ~30MB
#   4. 配置非 Root 最小权限运行用户 (UID 10001) 与时区
# ==============================================================================

# ── 全局构建参数 ─────────────────────────────────────────────────────────────
ARG RUST_VERSION=1.97.1
ARG ALPINE_VERSION=3.24

# ── 阶段 1：Chef 基础阶段（直接使用官方 cargo-chef Alpine 预装镜像）───────────────
FROM lukemathwalker/cargo-chef:latest-rust-${RUST_VERSION}-alpine${ALPINE_VERSION} AS chef
WORKDIR /app
SHELL ["/bin/sh", "-o", "pipefail", "-c"]

# 安装 Musl 编译环境所需的底层工具与开发库
RUN apk add --no-cache musl-dev

# ── 阶段 2：Planner 依赖分析阶段（生成 recipe.json）───────────────────────────
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ── 阶段 3：Builder 预编译 Musl 依赖与源码构建阶段 ────────────────────
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json

# 预编译 Musl 第三方依赖 (启用 BuildKit Cargo 缓存挂载)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release --recipe-path recipe.json

# 复制源码并编译 Musl 纯静态二进制
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --bin locos

# ── 阶段 4：最小化 Alpine Runtime 运行镜像 ───────────────────────────────────
FROM alpine:${ALPINE_VERSION} AS runtime

ENV LOCO_ENV=production \
    PORT=5150 \
    BINDING=0.0.0.0 \
    TZ=Asia/Shanghai

RUN apk add --no-cache ca-certificates tzdata curl \
    && cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app --no-create-home app

WORKDIR /app

# 从 Builder 阶段复制静态二进制、配置文件与国际化资源
COPY --from=builder /app/target/release/locos /app/locos
COPY config/ /app/config/
COPY locales/ /app/locales/

# 预建运行时可写目录并授权给非 root 用户
RUN mkdir -p storages/logs storages/uploads storages/tmp && chown -R app:app /app

USER 10001:10001
EXPOSE 5150

# 生产健康检查 (通过 /api/health 接口感知实例活性)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5150/api/health || exit 1

ENTRYPOINT ["/app/locos"]
CMD ["start"]
