# ==============================================================================
# 文件作用：Alpine (Musl) 纯静态极致轻量容器镜像构建规范
# 生效时机：执行 `docker build -f Dockerfile.alpine .` 时执行
# 核心职责：
#   1. 使用 musl-gcc 静态交叉编译出完全零动态依赖的独立 Rust 二进制程序
#   2. 采用 Alpine Linux 最小运行底包，最终容器镜像体积仅 ~30MB
#   3. 适用于对容器冷启动速度与磁盘占用要求极苛刻的云原生 / Serverless 环境
# ==============================================================================

# ── 阶段 1：Builder 源码构建阶段 ─────────────────────────────────────────────
FROM clux/muslrust:stable AS builder
WORKDIR /app
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 复制源码并编译 Musl 纯静态二进制
COPY . .
RUN cargo build --release --bin locos \
    && cp target/*/release/locos /locos

# ── 阶段 2：最小化 Alpine Runtime 运行镜像 ───────────────────────────────────
FROM alpine:3.21 AS runtime

ENV LOCO_ENV=production \
    PORT=5150 \
    BINDING=0.0.0.0 \
    TZ=Asia/Shanghai

RUN apk add --no-cache ca-certificates tzdata wget \
    && cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app --no-create-home app

WORKDIR /app

# 从 Builder 阶段复制静态二进制与配置文件
COPY --from=builder /locos /app/locos
COPY config/ /app/config/

# 预建运行时可写目录
RUN mkdir -p storages/logs storages/uploads storages/tmp && chown -R app:app /app

USER 10001:10001
EXPOSE 5150

# 容器健康检查探针
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5150/health || exit 1

ENTRYPOINT ["/app/locos"]
CMD ["start"]
