# ── 阶段 1：编译二进制（静态 musl）────────────────────────────────────────────
FROM clux/muslrust:stable AS builder
ENV CARGO_INCREMENTAL=0

WORKDIR /app
COPY . .
RUN cargo build --release --bin locos \
    && cp target/*/release/locos /locos

# ── 阶段 2：最小化 Alpine runtime 镜像 ───────────────────────────────────────
FROM alpine:3.24 AS runtime

ENV LOCO_ENV=production \
    PORT=5150 \
    BINDING=0.0.0.0 \
    TZ=Asia/Shanghai

RUN apk add --no-cache ca-certificates tzdata \
    && cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app --no-create-home app

WORKDIR /app

COPY --from=builder /locos .
COPY config/ config/

RUN mkdir -p storages/logs storages/uploads && chown -R app:app /app

USER 10001:10001

EXPOSE 5150

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5150/health || exit 1

ENTRYPOINT ["./locos"]
CMD ["start"]


