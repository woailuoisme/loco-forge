ARG CARGO_CHEF_VERSION=v0.1.77

# ── 阶段 1：Chef 基础阶段（Musl 环境安装 cargo-chef 预编译二进制）────────────
FROM clux/muslrust:stable AS chef
ARG CARGO_CHEF_VERSION
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /app
RUN curl --proto '=https' --tlsv1.2 -LsSf https://github.com/LukeMathWalker/cargo-chef/releases/download/${CARGO_CHEF_VERSION}/cargo-chef-installer.sh | sh

# ── 阶段 2：Planner 依赖分析阶段 ───────────────────────────────────────────────
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ── 阶段 3：Builder 预编译 Musl 依赖与源码构建阶段 ────────────────────────────
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --release --bin locos \
    && cp target/*/release/locos /locos

# ── 阶段 4：最小化 Alpine runtime 镜像 ───────────────────────────────────────
FROM alpine:3.24 AS runtime

ENV LOCO_ENV=production \
    PORT=5150 \
    BINDING=0.0.0.0 \
    TZ=Asia/Shanghai

RUN apk add --no-cache ca-certificates tzdata \
    && cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app --no-create-home app

WORKDIR /app

COPY --from=builder /locos .
COPY config/ config/

RUN mkdir -p storages/logs storages/uploads && chown -R app:app /app

USER 10001:10001

EXPOSE 5150

HEALTHCHECK --interval=60s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5150/health || exit 1

ENTRYPOINT ["./locos"]
CMD ["start"]
